-- ==========================================================
-- MARKERS
-- ==========================================================

local function resetMarkers()

	if markerFolder
		and markerFolder.Parent
	then

		markerFolder:
			Destroy()
	end

	markerFolder =
		Instance.new("Folder")

	markerFolder.Name =
		"AutoDoerNodeMarkers"

	markerFolder.Parent =
		Workspace

	markers = {}
end

local function createMarker(
	index,
	node
)

	local position =
		getNodePosition(
			node
		)

	if not position then
		return nil
	end

	local part =
		Instance.new("Part")

	part.Name =
		"RouteNode_"
		.. tostring(index)

	part.Shape =
		Enum.PartType.Ball

	part.Size =
		Vector3.new(
			1,
			1,
			1
		)

	part.Material =
		Enum.Material.Neon

	part.Color =
		markerColor(
			node
		)

	part.Anchored =
		true

	part.CanCollide =
		false

	part.CanTouch =
		false

	part.CanQuery =
		false

	part.Transparency =
		0.15

	part.Position =
		position
		+ Vector3.new(
			0,
			1.5,
			0
		)

	part.Parent =
		markerFolder

	local billboard =
		Instance.new(
			"BillboardGui"
		)

	billboard.Size =
		UDim2.fromOffset(
			160,
			48
		)

	billboard.StudsOffset =
		Vector3.new(
			0,
			1,
			0
		)

	billboard.AlwaysOnTop =
		true

	billboard.Parent =
		part

	local label =
		Instance.new("TextLabel")

	label.Size =
		UDim2.fromScale(
			1,
			1
		)

	label.BackgroundColor3 =
		Color3.fromRGB(
			15,
			15,
			18
		)

	label.BackgroundTransparency =
		0.25

	label.BorderSizePixel =
		0

	label.Text =
		nodeText(
			node,
			index
		)

	label.TextColor3 =
		Color3.new(
			1,
			1,
			1
		)

	label.TextWrapped =
		true

	label.TextSize =
		12

	label.Font =
		Enum.Font.SourceSansBold

	label.Parent =
		billboard

	return {

		Part =
			part,

		Label =
			label
	}
end

local function rebuildMarkers()

	resetMarkers()

	for index, node in ipairs(
		nodes
	) do

		markers[index] =
			createMarker(
				index,
				node
			)
	end
end

local function updateMarkers()

	for index, node in ipairs(
		nodes
	) do

		local marker =
			markers[index]

		if marker
			and marker.Part
			and marker.Part.Parent
		then

			local position =
				getNodePosition(
					node
				)

			if position then

				marker.Part.Position =
					position
					+ Vector3.new(
						0,
						1.5,
						0
					)
			end

			marker.Part.Color =
				markerColor(
					node
				)

			marker.Label.Text =
				nodeText(
					node,
					index
				)

			if currentNodeIndex
				== index
			then

				marker.Part.Size =
					Vector3.new(
						1.6,
						1.6,
						1.6
					)

			elseif selectedNodeIndex
				== index
			then

				marker.Part.Size =
					Vector3.new(
						1.25,
						1.25,
						1.25
					)

			else

				marker.Part.Size =
					Vector3.new(
						1,
						1,
						1
					)
			end
		end
	end
end

-- ==========================================================
-- DIRECT WALK
-- ==========================================================

local function directWalk(
	targetPosition,
	arrivalDistance,
	runId
)

	arrivalDistance =
		arrivalDistance
		or SETTINGS.DirectArrivalDistance

	local started =
		os.clock()

	local lastRefresh =
		0

	local lastCheck =
		os.clock()

	local _,
		_,
		startRoot =
		getCharacter()

	local lastPosition =
		startRoot
		and startRoot.Position
		or nil

	while alive do

		if stopRequested
			or runId ~= routeId
		then

			stopMovement()

			return false,
				"Stopped"
		end

		local character,
			humanoid,
			root =
			getCharacter()

		if not character then

			return false,
				"No character"
		end

		local difference =
			targetPosition
			- root.Position

		local horizontal =
			Vector3.new(
				difference.X,
				0,
				difference.Z
			)

		if horizontal.Magnitude
			<= arrivalDistance
		then

			stopMovement()

			return true
		end

		if SETTINGS.DirectTimeout > 0
			and os.clock()
				- started
				>= SETTINGS.DirectTimeout
		then

			stopMovement()

			return false,
				"Direct timeout"
		end

		if os.clock()
			- lastRefresh
			>= SETTINGS.DirectRefreshRate
		then

			humanoid:
				MoveTo(
					targetPosition
				)

			lastRefresh =
				os.clock()
		end

		if os.clock()
			- lastCheck
			>= SETTINGS.DirectStuckCheckInterval
		then

			if lastPosition then

				local moved =
					(
						root.Position
						- lastPosition
					).Magnitude

				if moved
					<= SETTINGS.DirectMinimumMovement
					and SETTINGS.DirectAutoJump
				then

					humanoid.Jump =
						true

					humanoid:
						MoveTo(
							targetPosition
						)
				end
			end

			lastPosition =
				root.Position

			lastCheck =
				os.clock()
		end

		RunService.Heartbeat:
			Wait()
	end

	return false
end

-- ==========================================================
-- PATHFINDING WALK
-- ==========================================================

local function pathfindWalk(
	targetPosition,
	arrivalDistance,
	runId
)

	arrivalDistance =
		arrivalDistance
		or SETTINGS.FinalWaypointDistance

	for retry = 1,
		SETTINGS.MaxPathRetries
	do

		if stopRequested
			or runId ~= routeId
		then

			return false,
				"Stopped"
		end

		local character,
			humanoid,
			root =
			getCharacter()

		if not character then

			return false,
				"No character"
		end

		local path =
			PathfindingService:
				CreatePath({

					AgentRadius =
						SETTINGS.AgentRadius,

					AgentHeight =
						SETTINGS.AgentHeight,

					AgentCanJump =
						SETTINGS.AgentCanJump,

					WaypointSpacing =
						SETTINGS.WaypointSpacing
				})

		local calculated =
			pcall(function()

				path:
					ComputeAsync(
						root.Position,
						targetPosition
					)
			end)

		if calculated
			and path.Status
				== Enum.PathStatus.Success
		then

			local waypoints =
				path:
					GetWaypoints()

			local failed =
				false

			for waypointIndex,
				waypoint in ipairs(
					waypoints
				)
			do

				if stopRequested
					or runId ~= routeId
				then

					stopMovement()

					return false,
						"Stopped"
				end

				if waypoint.Action
					== Enum.PathWaypointAction.Jump
				then

					humanoid.Jump =
						true
				end

				local final =
					waypointIndex
					== #waypoints

				local requiredDistance =
					final
					and arrivalDistance
					or SETTINGS.IntermediateWaypointDistance

				local started =
					os.clock()

				local lastCheck =
					os.clock()

				local lastPosition =
					root.Position

				humanoid:
					MoveTo(
						waypoint.Position
					)

				while alive do

					if stopRequested
						or runId ~= routeId
					then

						stopMovement()

						return false,
							"Stopped"
					end

					character,
						humanoid,
						root =
						getCharacter()

					if not character then

						return false,
							"Character lost"
					end

					local difference =
						waypoint.Position
						- root.Position

					local horizontal =
						Vector3.new(
							difference.X,
							0,
							difference.Z
						)

					if horizontal.Magnitude
						<= requiredDistance
					then

						break
					end

					if os.clock()
						- started
						>= SETTINGS.WaypointTimeout
					then

						failed =
							true

						break
					end

					humanoid:
						MoveTo(
							waypoint.Position
						)

					if os.clock()
						- lastCheck
						>= SETTINGS.PathStuckCheckInterval
					then

						local moved =
							(
								root.Position
								- lastPosition
							).Magnitude

						if moved
							<= SETTINGS.PathMinimumMovement
						then

							humanoid.Jump =
								true

							humanoid:
								MoveTo(
									waypoint.Position
								)
						end

						lastPosition =
							root.Position

						lastCheck =
							os.clock()
					end

					RunService.Heartbeat:
						Wait()
				end

				if failed then

					break
				end
			end

			if not failed then

				stopMovement()

				return true
			end
		end

		task.wait(
			0.15
		)
	end

	stopMovement()

	return false,
		"Path failed"
end

-- ==========================================================
-- WALK ROUTER
-- ==========================================================

local function walkTo(
	position,
	distance,
	runId
)

	if SETTINGS.MovementMode
		== "Direct"
	then

		return directWalk(
			position,
			distance,
			runId
		)

	else

		return pathfindWalk(
			position,
			distance,
			runId
		)
	end
end

-- ==========================================================
-- PROXIMITY
-- ==========================================================

local function moveNearTarget(
	node,
	runId
)

	local target =
		node.Target

	if not target
		or not target.Parent
	then

		return false,
			"Target missing"
	end

	local distance =
		node.Distance
		or SETTINGS.DefaultProximityDistance

	while alive do

		if stopRequested
			or runId ~= routeId
		then

			stopMovement()

			return false,
				"Stopped"
		end

		local targetPosition =
			getInstancePosition(
				target
			)

		local character,
			humanoid,
			root =
			getCharacter()

		if not targetPosition
			or not character
		then

			return false,
				"Target lost"
		end

		local difference =
			targetPosition
			- root.Position

		local horizontal =
			Vector3.new(
				difference.X,
				0,
				difference.Z
			)

		if horizontal.Magnitude
			<= distance
		then

			stopMovement()

			return true
		end

		if SETTINGS.MovementMode
			== "Direct"
		then

			humanoid:
				MoveTo(
					targetPosition
				)

			RunService.Heartbeat:
				Wait()

		else

			local success =
				pathfindWalk(
					targetPosition,
					math.max(
						1,
						distance - 1
					),
					runId
				)

			if not success then

				return false,
					"Could not reach target"
			end
		end
	end

	return false
end

-- ==========================================================
-- KEY PRESS / HOLD
-- ==========================================================

local function holdKey(
	keyCode,
	duration
)

	if not keyCode
		or keyCode
			== Enum.KeyCode.Unknown
	then

		return false
	end

	VirtualInputManager:
		SendKeyEvent(
			true,
			keyCode,
			false,
			game
		)

	local started =
		os.clock()

	while os.clock()
		- started
		< duration
	do

		if stopRequested then
			break
		end

		task.wait(
			0.02
		)
	end

	VirtualInputManager:
		SendKeyEvent(
			false,
			keyCode,
			false,
			game
		)

	return true
end

local function pressKey(
	keyCode
)

	return holdKey(
		keyCode,
		0.08
	)
end

-- ==========================================================
-- PROMPT
-- ==========================================================

local function executePrompt(
	node,
	runId
)

	local prompt =
		node.Prompt

	if not prompt
		or not prompt.Parent
		or not prompt:IsA(
			"ProximityPrompt"
		)
	then

		return false,
			"Prompt missing"
	end

	local position =
		getInstancePosition(
			prompt
		)

	if not position then

		return false,
			"No prompt position"
	end

	local distance =
		math.max(
			1,
			prompt.MaxActivationDistance
				- 1
		)

	local reached =
		walkTo(
			position,
			distance,
			runId
		)

	if not reached then

		return false,
			"Could not reach prompt"
	end

	local firePrompt =
		rawget(
			getgenv(),
			"fireproximityprompt"
		)

	if typeof(firePrompt)
		== "function"
	then

		local success =
			pcall(function()

				firePrompt(
					prompt
				)
			end)

		if success then
			return true
		end
	end

	if prompt.KeyboardKeyCode
		== Enum.KeyCode.Unknown
	then

		return false,
			"No prompt key"
	end

	return holdKey(
		prompt.KeyboardKeyCode,
		prompt.HoldDuration
			+ 0.1
	)
end

-- ==========================================================
-- CLICK DETECTOR HELPERS
-- ==========================================================

local function clickDetectorPosition(
	detector
)

	if not detector
		or not detector.Parent
	then

		return nil
	end

	return getInstancePosition(
		detector
	)
end

local function moveToClickDetector(
	detector,
	runId
)

	local position =
		clickDetectorPosition(
			detector
		)

	if not position then

		return false,
			"No ClickDetector position"
	end

	local distance =
		math.max(
			1,
			detector.MaxActivationDistance
				- 1
		)

	return walkTo(
		position,
		distance,
		runId
	)
end

-- ==========================================================
-- CLICK NODE
-- ==========================================================

local function executeClick(
	node,
	runId
)

	local detector =
		node.ClickDetector

	if not detector
		or not detector.Parent
		or not detector:IsA(
			"ClickDetector"
		)
	then

		return false,
			"ClickDetector missing"
	end

	local reached =
		moveToClickDetector(
			detector,
			runId
		)

	if not reached then

		return false,
			"Could not reach ClickDetector"
	end

	local fireClick =
		rawget(
			getgenv(),
			"fireclickdetector"
		)

	if typeof(fireClick)
		== "function"
	then

		local success,
			err =
			pcall(function()

				fireClick(
					detector
				)
			end)

		if success then
			return true
		end

		return false,
			tostring(err)
	end

	return false,
		"fireclickdetector unavailable"
end

-- ==========================================================
-- HOLD CLICK NODE
-- ==========================================================
--
-- Unlike CLICK, this physically holds MouseButton1.
--
-- It:
-- 1. walks into ClickDetector range
-- 2. finds detector position on screen
-- 3. Mouse1 DOWN
-- 4. waits Duration
-- 5. Mouse1 UP
--
-- ==========================================================

local function executeHoldClick(
	node,
	runId
)

	local detector =
		node.ClickDetector

	if not detector
		or not detector.Parent
		or not detector:IsA(
			"ClickDetector"
		)
	then

		return false,
			"ClickDetector missing"
	end

	local reached =
		moveToClickDetector(
			detector,
			runId
		)

	if not reached then

		return false,
			"Could not reach ClickDetector"
	end

	if stopRequested
		or runId ~= routeId
	then

		return false,
			"Stopped"
	end

	camera =
		Workspace.CurrentCamera

	if not camera then

		return false,
			"No camera"
	end

	local worldPosition =
		clickDetectorPosition(
			detector
		)

	if not worldPosition then

		return false,
			"No target position"
	end

	local screenPosition,
		onScreen =
		camera:
			WorldToViewportPoint(
				worldPosition
			)

	if not onScreen then

		return false,
			"Target not visible on screen"
	end

	local duration =
		math.max(
			0.05,
			node.Duration
				or SETTINGS.DefaultHoldClickDuration
		)

	-- Mouse down.

	VirtualInputManager:
		SendMouseButtonEvent(
			screenPosition.X,
			screenPosition.Y,
			0,
			true,
			game,
			0
		)

	local started =
		os.clock()

	while os.clock()
		- started
		< duration
	do

		if stopRequested
			or runId ~= routeId
		then

			break
		end

		task.wait(
			0.02
		)
	end

	-- Always release.

	VirtualInputManager:
		SendMouseButtonEvent(
			screenPosition.X,
			screenPosition.Y,
			0,
			false,
			game,
			0
		)

	return true
end

-- ==========================================================
-- TP
-- ==========================================================

local function executeTeleport(
	node
)

	if typeof(node.Position)
		~= "Vector3"
	then

		return false,
			"No TP position"
	end

	local character,
		_,
		root =
		getCharacter()

	if not character then

		return false,
			"No character"
	end

	stopMovement()

	local look =
		root.CFrame.LookVector

	local flatLook =
		Vector3.new(
			look.X,
			0,
			look.Z
		)

	if flatLook.Magnitude
		< 0.01
	then

		flatLook =
			Vector3.new(
				0,
				0,
				-1
			)
	end

	flatLook =
		flatLook.Unit

	root.AssemblyLinearVelocity =
		Vector3.zero

	root.AssemblyAngularVelocity =
		Vector3.zero

	root.CFrame =
		CFrame.lookAt(
			node.Position,
			node.Position
				+ flatLook,
			Vector3.yAxis
		)

	task.wait()

	return true
end

-- ==========================================================
-- EXECUTE NODE
-- ==========================================================

local function executeNode(
	node,
	runId
)

	if node.Type == "Walk" then

		if typeof(node.Position)
			~= "Vector3"
		then

			return false,
				"No Walk position"
		end

		return walkTo(
			node.Position,
			SETTINGS.MovementMode
				== "Direct"
				and SETTINGS.DirectArrivalDistance
				or SETTINGS.FinalWaypointDistance,
			runId
		)

	elseif node.Type == "TP" then

		return executeTeleport(
			node
		)

	elseif node.Type == "Wait" then

		local duration =
			math.max(
				0,
				node.Duration
					or SETTINGS.DefaultWaitDuration
			)

		local started =
			os.clock()

		while os.clock()
			- started
			< duration
		do

			if stopRequested
				or runId ~= routeId
			then

				return false,
					"Stopped"
			end

			task.wait(
				0.05
			)
		end

		return true

	elseif node.Type == "Proximity" then

		return moveNearTarget(
			node,
			runId
		)

	elseif node.Type == "Prompt" then

		return executePrompt(
			node,
			runId
		)

	elseif node.Type == "Click" then

		return executeClick(
			node,
			runId
		)

	elseif node.Type == "HoldClick" then

		return executeHoldClick(
			node,
			runId
		)

	elseif node.Type == "Jump" then

		local _,
			humanoid =
			getCharacter()

		if humanoid then

			humanoid.Jump =
				true

			task.wait(
				0.15
			)

			return true
		end

	elseif node.Type == "Key" then

		return pressKey(
			node.KeyCode
		)

	elseif node.Type == "HoldKey" then

		return holdKey(
			node.KeyCode,
			node.Duration
				or SETTINGS.DefaultHoldKeyDuration
		)
	end

	return false,
		"Unknown node"
end

