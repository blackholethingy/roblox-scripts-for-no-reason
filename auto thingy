local function updateEditor()

	local node =
		selectedNodeIndex
		and nodes[
			selectedNodeIndex
		]

	if not node then

		editorLabel.Text =
			"SELECT A NODE"

		return
	end

	if node.Type == "Wait" then

		editorLabel.Text =
			"WAIT: "
			.. string.format(
				"%.1fs",
				node.Duration or 2
			)

	elseif node.Type == "Proximity" then

		editorLabel.Text =
			"PROX DISTANCE: "
			.. tostring(
				node.Distance or 6
			)

	elseif node.Type == "HoldClick" then

		editorLabel.Text =
			"HOLD CLICK: "
			.. string.format(
				"%.1fs",
				node.Duration
					or 1
			)

	elseif node.Type == "Key" then

		editorLabel.Text =
			"KEY: "
			.. (
				node.KeyCode
				and node.KeyCode.Name
				or "None"
			)

	elseif node.Type == "HoldKey" then

		editorLabel.Text =
			"HOLD KEY: "
			.. (
				node.KeyCode
				and node.KeyCode.Name
				or "None"
			)
			.. " / "
			.. string.format(
				"%.1fs",
				node.Duration
					or 1
			)

	else

		editorLabel.Text =
			node.Type
	end
end

