-- ==========================================================
-- RUN
-- ==========================================================

local function runRoute()

	if executing then
		return
	end

	if #nodes == 0 then

		status.Text =
			"No nodes."

		return
	end

	executing =
		true

	stopRequested =
		false

	routeId +=
		1

	local thisRun =
		routeId

	task.spawn(function()

		repeat

			for index, node in ipairs(
				nodes
			) do

				if stopRequested
					or thisRun
						~= routeId
				then

					break
				end

				currentNodeIndex =
					index

				status.Text =
					nodeText(
						node,
						index
					)

				updateMarkers()

				local success,
					reason =
					executeNode(
						node,
						thisRun
					)

				if stopRequested
					or thisRun
						~= routeId
				then

					break
				end

				if not success then

					executing =
						false

					currentNodeIndex =
						nil

					stopMovement()

					status.Text =
						"FAILED: "
						.. tostring(
							reason
								or "Unknown"
						)

					updateMarkers()

					return
				end

				task.wait(
					0.05
				)
			end

			if stopRequested
				or thisRun
					~= routeId
			then

				break
			end

		until not loopRoute

		executing =
			false

		currentNodeIndex =
			nil

		stopMovement()

		if not stopRequested then

			status.Text =
				"Route complete."
		end

		updateMarkers()
	end)
end

runButton.MouseButton1Click:
	Connect(
		runRoute
	)

