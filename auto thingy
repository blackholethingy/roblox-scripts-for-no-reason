-- ==========================================================
-- FIND PROMPT
-- ==========================================================

local function findPrompt(
	part
)

	if not part then
		return nil
	end

	local prompt =
		part:
			FindFirstChildWhichIsA(
				"ProximityPrompt",
				true
			)

	if prompt then
		return prompt
	end

	local current =
		part.Parent

	for _ = 1, 6 do

		if not current then
			break
		end

		local found =
			current:
				FindFirstChildWhichIsA(
					"ProximityPrompt",
					true
				)

		if found then
			return found
		end

		current =
			current.Parent
	end

	return nil
end

-- ==========================================================
-- FIND CLICK DETECTOR
-- ==========================================================

local function findClickDetector(
	part
)

	if not part then
		return nil
	end

	local detector =
		part:
			FindFirstChildWhichIsA(
				"ClickDetector",
				true
			)

	if detector then
		return detector
	end

	local current =
		part.Parent

	for _ = 1, 6 do

		if not current then
			break
		end

		local found =
			current:
				FindFirstChildWhichIsA(
					"ClickDetector",
					true
				)

		if found then
			return found
		end

		current =
			current.Parent
	end

	return nil
end

-- ==========================================================
-- WORLD PLACEMENT
-- ==========================================================

track(
	mouse.Button1Down:
		Connect(function()

			if not placementMode then
				return
			end

			local target =
				mouse.Target

			local hitPosition =
				mouse.Hit.Position

			if placementMode == "Walk" then

				addNode({

					Type =
						"Walk",

					Position =
						hitPosition
				})

				placementMode =
					nil

				return
			end

			if placementMode == "TP" then

				addNode({

					Type =
						"TP",

					Position =
						hitPosition
						+ Vector3.new(
							0,
							SETTINGS.TeleportHeightOffset,
							0
						)
				})

				placementMode =
					nil

				return
			end

			if placementMode
				== "Proximity"
			then

				if target then

					addNode({

						Type =
							"Proximity",

						Target =
							target,

						Distance =
							SETTINGS.DefaultProximityDistance
					})
				end

				placementMode =
					nil

				return
			end

			if placementMode == "Prompt" then

				local prompt =
					findPrompt(
						target
					)

				if prompt then

					addNode({

						Type =
							"Prompt",

						Prompt =
							prompt
					})
				else

					status.Text =
						"No ProximityPrompt found."
				end

				placementMode =
					nil

				return
			end

			if placementMode == "Click"
				or placementMode
					== "HoldClick"
			then

				local detector =
					findClickDetector(
						target
					)

				if detector then

					if placementMode
						== "HoldClick"
					then

						addNode({

							Type =
								"HoldClick",

							ClickDetector =
								detector,

							Duration =
								SETTINGS.DefaultHoldClickDuration
						})

					else

						addNode({

							Type =
								"Click",

							ClickDetector =
								detector
						})
					end

				else

					status.Text =
						"No ClickDetector found."
				end

				placementMode =
					nil

				return
			end

			-- ==================================================
			-- EDIT TARGETS
			-- ==================================================

			if not selectedNodeIndex then

				placementMode =
					nil

				return
			end

			local node =
				nodes[
					selectedNodeIndex
				]

			if not node then

				placementMode =
					nil

				return
			end

			if placementMode == "EditWalk" then

				node.Position =
					hitPosition

			elseif placementMode == "EditTP" then

				node.Position =
					hitPosition
					+ Vector3.new(
						0,
						SETTINGS.TeleportHeightOffset,
						0
					)

			elseif placementMode
				== "EditProximity"
			then

				if target then

					node.Target =
						target
				end

			elseif placementMode == "EditPrompt" then

				local prompt =
					findPrompt(
						target
					)

				if prompt then

					node.Prompt =
						prompt
				end

			elseif placementMode == "EditClick"
				or placementMode
					== "EditHoldClick"
			then

				local detector =
					findClickDetector(
						target
					)

				if detector then

					node.ClickDetector =
						detector
				end
			end

			placementMode =
				nil

			rebuildList()
		end)
)

