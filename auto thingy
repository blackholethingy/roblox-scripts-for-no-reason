local function cleanup()

	if not alive then
		return
	end

	alive =
		false

	stopRoute()

	-- Safety releases.

	pcall(function()

		VirtualInputManager:
			SendMouseButtonEvent(
				0,
				0,
				0,
				false,
				game,
				0
			)
	end)

	for _, connection in ipairs(
		connections
	) do

		pcall(function()

			connection:
				Disconnect()

		end)
	end

	table.clear(
		connections
	)

	if markerFolder
		and markerFolder.Parent
	then

		markerFolder:
			Destroy()
	end

	if gui
		and gui.Parent
	then

		gui:
			Destroy()
	end

	getgenv().NodeAutoDoer =
		nil

	getgenv().NodeAutoDoerCleanup =
		nil

	print(
		"Node Auto-Doer killed."
	)
end

getgenv().NodeAutoDoerCleanup =
	cleanup

