-- ==========================================================
-- CONNECTION TRACKER
-- ==========================================================

local function track(connection)

	table.insert(
		connections,
		connection
	)

	return connection
end

-- ==========================================================
-- CHARACTER
-- ==========================================================

local function getCharacter()

	local character =
		player.Character

	if not character then
		return nil
	end

	local humanoid =
		character:
			FindFirstChildOfClass(
				"Humanoid"
			)

	local root =
		character:
			FindFirstChild(
				"HumanoidRootPart"
			)

	if not humanoid
		or not root
	then
		return nil
	end

	if humanoid.Health <= 0 then
		return nil
	end

	return character,
		humanoid,
		root
end

-- ==========================================================
-- STOP MOVEMENT
-- ==========================================================

local function stopMovement()

	local _,
		humanoid,
		root =
		getCharacter()

	if humanoid
		and root
	then

		humanoid:
			MoveTo(
				root.Position
			)

		humanoid:
			Move(
				Vector3.zero,
				false
			)
	end
end

-- ==========================================================
-- INSTANCE POSITION
-- ==========================================================

local function getInstancePosition(
	instance
)

	if not instance
		or not instance.Parent
	then

		return nil
	end

	if instance:IsA("Attachment") then

		return instance.WorldPosition
	end

	if instance:IsA("BasePart") then

		return instance.Position
	end

	if instance:IsA("Model") then

		return instance:
			GetPivot().Position
	end

	if instance:IsA("ProximityPrompt")
		or instance:IsA("ClickDetector")
	then

		local parent =
			instance.Parent

		if parent:IsA("Attachment") then

			return parent.WorldPosition

		elseif parent:IsA("BasePart") then

			return parent.Position

		elseif parent:IsA("Model") then

			return parent:
				GetPivot().Position
		end
	end

	local model =
		instance:
			FindFirstAncestorOfClass(
				"Model"
			)

	if model then

		return model:
			GetPivot().Position
	end

	return nil
end

-- ==========================================================
-- NODE POSITION
-- ==========================================================

local function getNodePosition(
	node
)

	if not node then
		return nil
	end

	if node.Type == "Walk"
		or node.Type == "TP"
	then

		return node.Position

	elseif node.Type == "Proximity" then

		return getInstancePosition(
			node.Target
		)

	elseif node.Type == "Prompt" then

		return getInstancePosition(
			node.Prompt
		)

	elseif node.Type == "Click"
		or node.Type == "HoldClick"
	then

		return getInstancePosition(
			node.ClickDetector
		)
	end

	return nil
end

-- ==========================================================
-- NODE TEXT
-- ==========================================================

local function nodeText(
	node,
	index
)

	if not node then

		return tostring(index)
			.. ". ???"
	end

	if node.Type == "Walk" then

		return tostring(index)
			.. ". WALK"

	elseif node.Type == "TP" then

		return tostring(index)
			.. ". TP"

	elseif node.Type == "Wait" then

		return tostring(index)
			.. ". WAIT "
			.. string.format(
				"%.1fs",
				node.Duration
					or SETTINGS.DefaultWaitDuration
			)

	elseif node.Type == "Proximity" then

		return tostring(index)
			.. ". PROX "
			.. (
				node.Target
				and node.Target.Name
				or "missing"
			)
			.. " ["
			.. tostring(
				node.Distance
					or SETTINGS.DefaultProximityDistance
			)
			.. "]"

	elseif node.Type == "Prompt" then

		return tostring(index)
			.. ". PROMPT "
			.. (
				node.Prompt
				and node.Prompt.Name
				or "missing"
			)

	elseif node.Type == "Click" then

		return tostring(index)
			.. ". CLICK "
			.. (
				node.ClickDetector
				and node.ClickDetector.Parent
				and node.ClickDetector.Parent.Name
				or "missing"
			)

	elseif node.Type == "HoldClick" then

		return tostring(index)
			.. ". HOLD CLICK "
			.. string.format(
				"%.1fs",
				node.Duration
					or SETTINGS.DefaultHoldClickDuration
			)

	elseif node.Type == "Jump" then

		return tostring(index)
			.. ". JUMP"

	elseif node.Type == "Key" then

		return tostring(index)
			.. ". KEY ["
			.. (
				node.KeyCode
				and node.KeyCode.Name
				or "None"
			)
			.. "]"

	elseif node.Type == "HoldKey" then

		return tostring(index)
			.. ". HOLD KEY ["
			.. (
				node.KeyCode
				and node.KeyCode.Name
				or "None"
			)
			.. "] "
			.. string.format(
				"%.1fs",
				node.Duration
					or SETTINGS.DefaultHoldKeyDuration
			)
	end

	return tostring(index)
		.. ". "
		.. tostring(
			node.Type
		)
end

